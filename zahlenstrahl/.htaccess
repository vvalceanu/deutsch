# Zahlenstrahl — static files only, no build step.

AddDefaultCharset UTF-8

<IfModule mod_mime.c>
  AddType text/javascript .js
</IfModule>

# The page itself changes; the rest can sit in cache.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^tests/ - [F,L]
</IfModule>
